{
  "name": "web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest",
    "format": "prettier --write .",
    "types": "json2ts -i ../../shared/schemas/contracts.schema.json -o lib/types.ts --unreachableDefinitions --unknownAny --bannerComment \"/* Generated by make types from apps/api/app/models.py. Do not edit. */\"",
    "demo:sync": "node scripts/sync-demo.mjs",
    "demo:check": "node scripts/sync-demo.mjs --check"
  },
  "dependencies": {
    "next": "16.4.2",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^24.19.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "json-schema-to-typescript": "^16.0.0",
    "prettier": "^3.9.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^5.0.5"
  }
}
