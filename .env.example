# Copy to .env (repo root) and fill in the two keys. Never commit .env.

# TinyFish API key from https://agent.tinyfish.ai/api-keys (sent as the X-API-Key header)
TINYFISH_API_KEY=
# Anthropic API key for the diagnoser and the Fetch-rung extractor
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5

# SQLite by default (path relative to apps/api). Postgres: postgresql+asyncpg://USER:PASSWORD@HOST:5432/autopsy
DATABASE_URL=sqlite+aiosqlite:///./autopsy.db

# live = call TinyFish; replay = stream recorded traces from fixtures/traces/
MODE=live

# Hard budget per run (credits are estimated as 1 per agent step)
MAX_ATTEMPTS=4
MAX_CREDITS=40

# Proxy exit country used on rung 3 (ISO 3166-1 alpha-2)
PROXY_COUNTRY=US
